{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Grubie Launcher inside the game: invites and messages from friends as toasts, and the Play Together host panel.",
  "authors": ["Grubie Launcher"],
  "contact": {
    "homepage": "https://grubielauncher.com"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.grubielauncher.companion.fabric.FabricEntry"]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_min}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_release}"
  }
}
